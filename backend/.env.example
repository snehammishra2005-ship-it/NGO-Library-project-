# ---------------------------------------------------------------------
#  Backend configuration. Copy to `.env` and fill in real values.
#  ONE backend serves two separated API layers:
#    /api/public/*  → used by the reader site   (read-only + reader accounts)
#    /api/admin/*   → used by the admin app      (staff auth + role checks)
# ---------------------------------------------------------------------

# Server
PORT=4000
# Comma-separated allowed origins: reader site, then admin app.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth — CHANGE THIS to a long random string in any real deployment.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Data backend: "mock" runs a functional in-memory store (no Oracle needed).
# Switch to "oracle" once the Instant Client and schema are set up.
DB_MODE=mock

# ---- Oracle connection (only used when DB_MODE=oracle) ----------------
ORACLE_USER=library_app
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=localhost:1521/XE
ORACLE_CLIENT_DIR=
