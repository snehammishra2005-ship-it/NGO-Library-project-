# Reader site config. Copy to `.env` only if you deploy the reader site
# SEPARATELY from the backend. In local dev you don't need this — the Vite
# proxy forwards /api to the backend on http://localhost:4000.

# Public backend origin (the admin product hosts this backend). Example:
# VITE_API_BASE=https://api.yourlibrary.com
VITE_API_BASE=
